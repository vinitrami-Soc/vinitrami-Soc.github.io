# ---------------------------------------------------------------------------
# IntelPulse configuration. Copy to .env — every key below is OPTIONAL.
# A provider with no key reports itself as "unconfigured" in /api/health and is
# skipped during triage; it never silently returns a clean verdict.
# ---------------------------------------------------------------------------

# --- free API keys ---------------------------------------------------------
# https://www.abuseipdb.com/account/api      (1,000 checks/day free)
ABUSEIPDB_API_KEY=
# https://otx.alienvault.com/api             (free, unlimited-ish)
OTX_API_KEY=
# https://viz.greynoise.io/signup            (community tier, 100 lookups/day)
GREYNOISE_API_KEY=
# https://auth.abuse.ch/                     (ThreatFox + URLhaus share one key)
ABUSECH_AUTH_KEY=

# --- storage ---------------------------------------------------------------
# Compose overrides these; they are the local-dev defaults.
DATABASE_URL=sqlite+aiosqlite:///./data/intelpulse.db
REDIS_URL=
POSTGRES_PASSWORD=intelpulse

# --- behaviour -------------------------------------------------------------
CACHE_TTL_SECONDS=86400
PROVIDER_TIMEOUT_SECONDS=8
MAX_IOCS_PER_REQUEST=100
# '*' is fine for a local demo. Set the dashboard's real origin before exposing
# this API — the app logs a warning if it sees '*' with ENVIRONMENT=production.
CORS_ORIGINS=*
LOG_LEVEL=INFO
# JSON logs with automatic credential masking; set false for human-readable dev logs.
JSON_LOGS=true

# --- request-path limits ---------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRIAGE=30        # enrichment spends third-party quota
RATE_LIMIT_WRITE=60
RATE_LIMIT_READ=240
MAX_REQUEST_BYTES=1048576   # JSON bodies (1 MiB)
MAX_INPUT_CHARS=200000      # one paste
# Enable ONLY behind a proxy you control — otherwise any client can forge
# X-Forwarded-For and mint a fresh rate-limit identity per request.
TRUST_FORWARDED_FOR=false

# --- scoring weights (see docs/SCORING.md) ---------------------------------
WEIGHT_ABUSEIPDB=1.0
WEIGHT_OTX=0.9
WEIGHT_THREATFOX=1.2
WEIGHT_URLHAUS=1.1
WEIGHT_LOCAL_BLOCKLIST=1.0
WEIGHT_GREYNOISE=0.6
WEIGHT_GEO_ASN=0.25
GREYNOISE_BENIGN_MULTIPLIER=0.45

# --- demo / offline mode ---------------------------------------------------
# Lets `python -m app.cli seed` data (RFC 5737 documentation IPs) be triaged.
# Leave false in anything resembling production.
ALLOW_DOCUMENTATION_RANGES=false
